{
  "name": "engineering-graphics",
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based Engineering Graphics first-angle orthographic projection platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:oracle": "vitest run testing/oracle/oracle.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:secrets": "npx tsx scripts/check-secrets.ts",
    "backup": "npx tsx scripts/backup.ts",
    "purge:retention": "npx tsx scripts/purge-retention.ts"
  },
  "keywords": [
    "engineering-graphics",
    "first-angle-projection",
    "orthographic-projection",
    "cad",
    "grading"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "occt-wasm": "5.8.1",
    "three": "0.186.1"
  }
}
